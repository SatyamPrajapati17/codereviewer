# ReviewGuard Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://reviewguard:reviewguard@localhost:5432/reviewguard

# Security
SECRET_KEY=your-secret-key-change-in-production
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# IBM Bob
BOB_API_KEY=your-bob-api-key
BOB_WORKFLOW_NAME=reviewguard

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000